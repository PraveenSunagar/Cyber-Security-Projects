import re
import hashlib
from pathlib import Path

INPUT_FILE = "input.txt"
REPORT_FILE = "ioc_report.txt"

def extract_ips(text):
    pattern = r'\b(?:\d{1,3}\.){3}\d{1,3}\b'
    return sorted(set(re.findall(pattern, text)))


def extract_domains(text):
    pattern = r'\b(?:[a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}\b'
    domains = re.findall(pattern, text)

   return sorted(set(domains))


def extract_urls(text):
    pattern = r'https?://[^\s<>"\']+'
    return sorted(set(re.findall(pattern, text)))


def extract_sha256(text):
    pattern = r'\b[a-fA-F0-9]{64}\b'
    return sorted(set(re.findall(pattern, text)))

def is_valid_ip(ip):
    parts = ip.split(".")

    if len(parts) != 4:
        return False

    for part in parts:
        if not part.isdigit():
            return False

        number = int(part)

        if number < 0 or number > 255:
            return False

    return True

def analyze_ioc(ip_list, domains, urls, hashes):

    suspicious_ips = []

    for ip in ip_list:
        if not is_valid_ip(ip):
            continue

        # Private IP detection
        first = int(ip.split(".")[0])

        if (
            ip.startswith("10.")
            or ip.startswith("192.168.")
            or ip.startswith("172.")
        ):
            continue

        suspicious_ips.append(ip)

    suspicious_domains = []

    suspicious_words = [
        "login",
        "verify",
        "secure",
        "account",
        "update",
        "bank",
        "password"
    ]

    for domain in domains:

        domain_lower = domain.lower()

        for word in suspicious_words:
            if word in domain_lower:
                suspicious_domains.append(domain)
                break

    return suspicious_ips, suspicious_domains


