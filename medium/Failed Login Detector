import re
from collections import Counter

LOG_FILE = "auth.log"

failed_ips = []
failed_users = []

try:
    with open(LOG_FILE, "r", encoding="utf-8") as file:
        lines = file.readlines()

except FileNotFoundError:
    print("❌ auth.log file not found!")
    exit()


for line in lines:

    # Detect failed login
    if "Failed login" in line or "Failed password" in line:

        # Extract IPv4 address
        ip_match = re.search(
            r'\b(?:\d{1,3}\.){3}\d{1,3}\b',
            line
        )

        if ip_match:
            failed_ips.append(ip_match.group())

        # Extract username
        user_match = re.search(
            r'(?:user|for)\s+([a-zA-Z0-9_.-]+)',
            line,
            re.IGNORECASE
        )

        if user_match:
            failed_users.append(user_match.group(1))


# Count attempts
ip_counts = Counter(failed_ips)
user_counts = Counter(failed_users)


print("=" * 60)
print("          FAILED LOGIN DETECTOR")
print("=" * 60)

print(f"\nTotal Failed Logins: {len(failed_ips)}")

print("\nFailed Login by IP")
print("-" * 40)

for ip, count in ip_counts.most_common():
    print(f"{ip:<20} {count} attempts")


print("\nFailed Login by User")
print("-" * 40)

for user, count in user_counts.most_common():
    print(f"{user:<20} {count} attempts")


# Detect possible brute force
print("\n========== SECURITY ALERTS ==========")

found_alert = False

for ip, count in ip_counts.items():

    if count >= 5:
        print(f"🚨 HIGH: Possible brute force from {ip}")
        print(f"   Failed attempts: {count}")
        found_alert = True

    elif count >= 3:
        print(f"⚠️ MEDIUM: Repeated failures from {ip}")
        print(f"   Failed attempts: {count}")
        found_alert = True


if not found_alert:
    print("✅ No suspicious login activity detected.")


print("\nScan Completed.")
