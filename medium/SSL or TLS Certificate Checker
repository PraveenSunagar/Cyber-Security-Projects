import ssl
import socket
from datetime import datetime

print("=" * 60)
print("        SSL/TLS CERTIFICATE CHECKER")
print("=" * 60)

domain = input("Enter Domain (example.com): ")

try:
    context = ssl.create_default_context()

    with socket.create_connection((domain, 443)) as sock:
        with context.wrap_socket(sock, server_hostname=domain) as ssock:

            cert = ssock.getpeercert()

            print("\n========== CERTIFICATE ==========")

            subject = dict(x[0] for x in cert['subject'])
            issuer = dict(x[0] for x in cert['issuer'])

            print("Common Name :", subject.get("commonName"))
            print("Organization:", subject.get("organizationName"))

            print("\nIssuer")
            print("CA :", issuer.get("organizationName"))

            expire_date = cert['notAfter']
            print("\nExpiry :", expire_date)

            expire = datetime.strptime(
                expire_date,
                "%b %d %H:%M:%S %Y %Z"
            )

            remaining = (expire - datetime.utcnow()).days

            print("Days Left :", remaining)

            if remaining > 30:
                print("Status : VALID")

            elif remaining > 0:
                print("Status : EXPIRING SOON")

            else:
                print("Status : EXPIRED")

except Exception as e:
    print("Error:", e)
